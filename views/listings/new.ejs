<% layout('/layouts/boilerplate') -%>

    <body>
        <h3>Create a new listing</h3>
        <div class="row">


            <form class="col-8 offset-2" method="POST" action="/listings">
                <div>
                    <label for="title" class="form-label">Enter the title</label>
                    <input type="text" name="listing[title]" placeholder="Enter the catchy title"
                        class="form-control" />
                </div>
                <div>
                    <label for="description" class="form-label">Enter the description</label>
                    <textarea type="text" name="listing[description]" placeholder="Enter the description"
                        class="form-control"></textarea>
                </div>
                <div>
                    <label for="image" class="form-label">Enter image </label>
                    <input type="text" name="listing[image]" placeholder="Enter image URL/Link" class="form-control" />
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <label for="price" class="form-label">Enter price</label>
                        <input type="number" name="listing[price]" placeholder="Enter price" class="form-control" />
                    </div>

                    <div class="col-md-8">
                        <label for="country" class="form-label ">Enter the country</label>
                        <input type="text" name="listing[country]" placeholder="Enter country" class="form-control" />
                    </div>
                </div>


                <div>
                    <label for="location" class="form-label">Enter the location</label>
                    <input type="text" name="listing[location]" placeholder="Enter location" class="form-control" />
                </div>
                <button class="btn btn-dark m-2 add-btn">Add</button>
            </form>

        </div>
    </body>